PORT=3001
DATABASE_URL=postgres://foodkoala:foodkoala@localhost:5432/foodkoala
REDIS_URL=redis://localhost:6379

# RS256 signing key, PKCS#8 PEM (\n escapes are fine). Required in production;
# without it a temporary key is generated and tokens die on restart.
# openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048
JWT_PRIVATE_KEY=
# JWT_ISSUER=foodkoala-auth
# JWT_AUDIENCE=foodkoala
# ACCESS_TOKEN_TTL_SECONDS=900
# REFRESH_TOKEN_TTL_DAYS=30

# Secret mixed into stored OTP hashes (at least 16 characters).
OTP_PEPPER=change-me-local-pepper
# OTP_TTL_SECONDS=300
# OTP_RESEND_SECONDS=60
# OTP_MAX_PER_HOUR=5
# OTP_MAX_ATTEMPTS=5

# `log` prints codes to the log; refused when NODE_ENV=production.
SMS_PROVIDER=log
