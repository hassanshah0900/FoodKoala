PORT=8083
# Chats and messages.
MONGO_URL=mongodb://localhost:27017
MONGO_DB=chat
# Live messages between replicas; every replica must use the same Redis.
REDIS_URL=redis://localhost:6379
# delivery.assigned opens a chat, delivery.delivered and order.status_changed close it.
# Unset: nothing is consumed and no chat ever opens.
KAFKA_BROKERS=localhost:9092
KAFKA_GROUP_ID=chat-service
# Photos (S3 or MinIO). Unset S3_ENDPOINT: photos are turned off.
S3_ENDPOINT=localhost:9000
S3_ACCESS_KEY=foodkoala
S3_SECRET_KEY=foodkoala-secret
S3_BUCKET=chat-photos
S3_USE_SSL=false
