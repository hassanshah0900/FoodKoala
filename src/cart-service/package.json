{
  "name": "cart-service",
  "version": "0.1.0",
  "private": true,
  "description": "Per-user carts stored in Redis, validated against the menu.",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "dev": "tsc-watch -p tsconfig.build.json --onSuccess \"node dist/main.js\"",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "^12.4.0",
    "@nestjs/core": "^12.4.0",
    "@nestjs/platform-express": "^12.4.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.4.0",
    "@swc/core": "^1.16.22",
    "@types/node": "^26.6.6",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1",
    "tsc-watch": "^7.2.1",
    "typescript": "^7.0.2",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.1.0"
  }
}
