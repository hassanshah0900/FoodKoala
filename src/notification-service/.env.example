PORT=3007
DATABASE_URL=postgres://foodkoala:foodkoala@localhost:5432/foodkoala
# Order events (order.placed, order.status_changed); unset, nothing is consumed
KAFKA_BROKERS=localhost:9092
# KAFKA_GROUP_ID=notification-service

# `log` prints SMS to the log (refused when NODE_ENV=production); `twilio` sends them
SMS_PROVIDER=log
# TWILIO_ACCOUNT_SID=AC...
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=MG... or +1...
# SMS_TIMEOUT_MS=5000
# SMS_POLL_MS=1000
# SMS_MAX_ATTEMPTS=5
